# Copia este archivo como .env y rellena los valores reales
# NUNCA subas .env al repositorio

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# API
HOST=0.0.0.0
PORT=8000

# Confianza backend -> microservicio IA. La clave pública no es secreta.
# Usa una sola alternativa: PEM con \\n o PEM codificado en Base64.
AI_SERVICE_JWT_PUBLIC_KEY=
AI_SERVICE_JWT_PUBLIC_KEY_BASE64=
AI_SERVICE_JWT_ISSUER=systemvet-api
AI_SERVICE_JWT_AUDIENCE=systemvet-ai
